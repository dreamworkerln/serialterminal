#!/usr/bin/env python3
"""Safely commit and push one new node observation from the sibling clone."""

from __future__ import annotations

import re
import subprocess
import sys
from pathlib import Path

MAIN_BRANCH = "dev"
OBS_BRANCH = "node_observations"
OBS_REPO_NAME = "serialterminal-observations"
HELPER_PATH = "scripts/commit-node-observation"
OBS_PATH_RE = re.compile(
    r"^observations/OBS_\d{8}T\d{6}Z_[a-z0-9][a-z0-9-]*\.md$"
)


class ObservationCommitError(RuntimeError):
    pass


def run_git(repo: Path, *args: str, check: bool = True) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(
        ["git", *args],
        cwd=repo,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if check and result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip() or "git command failed"
        raise ObservationCommitError(f"git {' '.join(args)}: {detail}")
    return result


def nul_paths(raw: str) -> list[str]:
    return [part for part in raw.split("\0") if part]


def require_trusted_helper(main_repo: Path) -> None:
    branch = run_git(main_repo, "branch", "--show-current").stdout.strip()
    if branch != MAIN_BRANCH:
        raise ObservationCommitError(
            f"main SerialTerminal clone must be on {MAIN_BRANCH}, found {branch or '<detached>'}"
        )

    run_git(main_repo, "ls-files", "--error-unmatch", "--", HELPER_PATH)
    if (
        run_git(
            main_repo,
            "diff",
            "--quiet",
            "HEAD",
            "--",
            HELPER_PATH,
            check=False,
        ).returncode
        != 0
    ):
        raise ObservationCommitError(
            "refusing elevated Git workflow because helper differs from current HEAD"
        )


def require_clean_tracked_state(repo: Path) -> None:
    if run_git(repo, "diff", "--quiet", check=False).returncode != 0:
        raise ObservationCommitError("observation clone has unstaged tracked changes")
    if run_git(repo, "diff", "--cached", "--quiet", check=False).returncode != 0:
        raise ObservationCommitError("observation clone already has staged changes")


def require_synced_with_origin(repo: Path) -> None:
    run_git(repo, "fetch", "--quiet", "origin", OBS_BRANCH)
    counts = run_git(
        repo,
        "rev-list",
        "--left-right",
        "--count",
        f"origin/{OBS_BRANCH}...HEAD",
    ).stdout.strip().split()
    if counts != ["0", "0"]:
        behind = counts[0] if counts else "?"
        ahead = counts[1] if len(counts) > 1 else "?"
        raise ObservationCommitError(
            f"observation clone is not synced with origin/{OBS_BRANCH} "
            f"(behind={behind}, ahead={ahead})"
        )


def main() -> int:
    if len(sys.argv) != 2:
        print(
            "usage: python3 -I scripts/commit-node-observation "
            "observations/OBS_YYYYMMDDTHHMMSSZ_<short-topic>.md",
            file=sys.stderr,
        )
        return 2

    observation_path = sys.argv[1]
    if not OBS_PATH_RE.fullmatch(observation_path):
        print("refusing invalid observation path", file=sys.stderr)
        return 2

    main_repo = Path(__file__).resolve().parent.parent
    obs_repo = main_repo.parent / OBS_REPO_NAME
    obs_file = obs_repo / observation_path

    try:
        require_trusted_helper(main_repo)

        if not obs_repo.is_dir() or not (obs_repo / ".git").is_dir():
            raise ObservationCommitError(
                f"expected independent sibling clone at ../{OBS_REPO_NAME}"
            )

        top = Path(run_git(obs_repo, "rev-parse", "--show-toplevel").stdout.strip()).resolve()
        if top != obs_repo.resolve():
            raise ObservationCommitError("unexpected observation repository root")

        branch = run_git(obs_repo, "branch", "--show-current").stdout.strip()
        if branch != OBS_BRANCH:
            raise ObservationCommitError(
                f"observation clone must be on {OBS_BRANCH}, found {branch or '<detached>'}"
            )

        upstream = run_git(
            obs_repo,
            "rev-parse",
            "--abbrev-ref",
            "--symbolic-full-name",
            "@{upstream}",
        ).stdout.strip()
        if upstream != f"origin/{OBS_BRANCH}":
            raise ObservationCommitError(
                f"expected upstream origin/{OBS_BRANCH}, found {upstream}"
            )

        require_clean_tracked_state(obs_repo)
        require_synced_with_origin(obs_repo)

        untracked = nul_paths(
            run_git(
                obs_repo,
                "ls-files",
                "--others",
                "--exclude-standard",
                "-z",
            ).stdout
        )
        if untracked != [observation_path]:
            raise ObservationCommitError(
                "expected exactly one untracked observation file; "
                f"found: {untracked or 'none'}"
            )

        if not obs_file.is_file():
            raise ObservationCommitError("observation file does not exist as a regular file")

        run_git(obs_repo, "add", "--", observation_path)

        staged = nul_paths(
            run_git(obs_repo, "diff", "--cached", "--name-only", "-z").stdout
        )
        staged_added = nul_paths(
            run_git(
                obs_repo,
                "diff",
                "--cached",
                "--diff-filter=A",
                "--name-only",
                "-z",
            ).stdout
        )
        if staged != [observation_path] or staged_added != [observation_path]:
            raise ObservationCommitError("staged change is not exactly one newly added observation")

        topic = Path(observation_path).stem.split("_", 2)[2].replace("-", " ")
        message = f"obs: {topic}"
        run_git(obs_repo, "commit", "-m", message, "--", observation_path)
        commit_sha = run_git(obs_repo, "rev-parse", "HEAD").stdout.strip()

        run_git(obs_repo, "push", "origin", f"HEAD:{OBS_BRANCH}")
        run_git(obs_repo, "fetch", "--quiet", "origin", OBS_BRANCH)

        if run_git(obs_repo, "status", "--porcelain").stdout.strip():
            raise ObservationCommitError("observation clone is not clean after push")

        counts = run_git(
            obs_repo,
            "rev-list",
            "--left-right",
            "--count",
            f"origin/{OBS_BRANCH}...HEAD",
        ).stdout.strip().split()
        if counts != ["0", "0"]:
            raise ObservationCommitError("push completed but local/remote refs are not synchronized")

        print(f"observation committed and pushed: {observation_path}")
        print(f"commit: {commit_sha}")
        return 0
    except ObservationCommitError as exc:
        print(f"OBSERVATION COMMIT FAILED: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
